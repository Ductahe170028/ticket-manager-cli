# Copy file này thành .env rồi chỉnh giá trị nếu cần — .env không commit lên git.

# Đường dẫn file JSON lưu tickets (không set -> mặc định data/tickets.json)
# TICKETS_PATH=./data/tickets.json

# Cổng server KB thật (npm run kb-server) lắng nghe (không set -> mặc định 4000)
PORT=4000

# Chọn KBClient cho CLI: mock (mặc định) hoặc http
KB_CLIENT=mock

# Bắt buộc nếu KB_CLIENT=http — URL server KB (npm run kb-server hoặc server thật của công ty)
KB_API_URL=http://localhost:4000
